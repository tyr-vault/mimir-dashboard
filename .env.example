# Public URL (OG tags, links). Browser-facing URL — not the in-container API host.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Mimir API (server-only; Nitro proxy forwards /api/mimir/* here)
# Host pnpm dev: http://localhost:5000
# Docker (compose overrides): http://host.docker.internal:5000
NUXT_MIMIR_API_BASE_URL=http://localhost:5000
